{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --pretty --transpile-only ./src/bin/www",
    "start": "node ./build/bin/www",
    "build": "tsc --skipLibCheck",
    "db:init": "node ./build/db/scripts/db_init.js",
    "db:init-dev": "ts-node ./src/db/scripts/db_init.ts",
    "db:createSuperAdmin": "node ./build/db/scripts/db_admin-create.ts",
    "db:createSuperAdmin-dev": "ts-node ./src/db/scripts/super_admin-create.ts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "~5.2.1",
    "express-jwt": "^8.5.1",
    "helmet": "^8.1.0",
    "http-errors": "~2.0.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "morgan": "~1.10.1",
    "mysql2": "^3.15.3",
    "sequelize": "^6.37.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/lodash": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
